---
import Section from "@layouts/Section.astro"
import CardsData from "@data/card"
import CardMood from "@components/CardMood.jsx"
import SpotlightCard from "@components/components/SpotlightCard"
---

<Section>
  <div class="md:grid md:grid-cols-3 flex flex-col gap-3">
    {
      CardsData.map(card => (
        <CardMood client:load title={card.en.title} description={card.en.description} icon={card.icon} />
      ))
    }
  </div>
</Section>
