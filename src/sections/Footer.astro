---
import TEnfasis from "@components/TEnfasis.astro"
import { getLangFromUrl, useTranslations } from "@i18n/utils"
import Section from "@layouts/Section.astro"
import { SiGithub, SiLinkedin } from "react-icons/si"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Section foo className="border-t border-zinc-800 py-10">
  <footer>
    <div
      class="flex flex-col-reverse lg:flex-row justify-between lg:h-[20vh] lg:px-8"
    >
      <div class="flex flex-col gap-6 not-lg:mt-12 not-lg:pb-12">
        <p class="text-muted-foreground">
          <span>Porfolio designed and built by John Gutierrez.</span><br />
          <span>Assets created by John Gutierrez in Blender.</span>
        </p>
        <div class="flex gap-3 items-center">
          <a
            href="https://github.com/JeegsCreator"
            target="_blank"
            class="flex gap-3 items-center"
          >
            <SiGithub size={20} />
            <span class="hidden">Github</span>
          </a>
          <a
            href="https://www.linkedin.com/in/jhonngutierrez/"
            target="_blank"
            class="flex gap-3 items-center"
          >
            <SiLinkedin size={20} />
            <span class="hidden">LinkedIn</span>
          </a>
        </div>
      </div>
      <div class="flex flex-col lg:flex-row gap-12">
        <div class="w-[200px]">
          <h2 class="font-semibold mb-5">Projects</h2>
          <ul class="text-muted-foreground space-y-3">
            <li>
              <a target="_blank" href='https://timezip.vercel.app/"'>TimeZip</a>
            </li>
            <li>
              <a target="_blank" href='https://cleanyoutube.vercel.app/"'
                >Clean YouTube</a
              >
            </li>
            <li>
              <a
                target="_blank"
                href='https://scroll-view-animation.vercel.app/"'
                >Tailwind CSS Plugin</a
              >
            </li>
          </ul>
        </div>
        <div class="w-[200px]">
          <h2 class="font-semibold mb-5">Case Studies</h2>
          <ul class="text-muted-foreground">
            <li><a href={`/${lang}/story/openversum`}>Openversum</a></li>
          </ul>
        </div>
      </div>
    </div>
  </footer>

  <!-- <Hero /> -->
</Section>
