---
import Section from "@layouts/Section.astro"
import Button from "@components/Button.astro"
import Card from "@components/Card.astro"
import CardDescription from "@components/CardDescription.astro"
import TEnfasis from "@components/TEnfasis.astro"
import Twitter from "@icons/Twitter.astro"
import LinkedIn from "@icons/LinkedIn.astro"
import BlueFigma from "@icons/BlueFigma.astro"
import Mesh from "@icons/Mesh.astro"
import GoLogo from "@icons/GoLogo.astro"
import JSLogo from "@icons/JSLogo.astro"
import ShinyText from "@components/components/ShinyText"

import { getLangFromUrl, useTranslations } from "@i18n/utils"
import Blub from "@components/Deco/Blub.astro"
import Image from "astro/components/Image.astro"
import HeroDeco from "@lib/images/decoration.webp"
import Threads from "@components/components/Threads"
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<div class="relative">
  <div class="absolute md:top-[-150px] top-[0px] left-0 w-full h-[700px] -z-10">
    <Threads
    client:load
    amplitude={1}
    distance={0}
    enableMouseInteraction={true}
  />
</div>
<Section>
  
  <div class="flex lg:justify-between lg:items-center justify-center flex-col lg:flex-row gap-8">
    <div>
      <h1 class="md:text-6xl text-4xl text-nowrap font-bold">{t("hero.webdev")}</h1>
      <!-- <h1 class="text-6xl leading-tight text-nowrap font-bold bg-clip-text text-transparent bg-gradient-to-b from-zinc-800 via-slate-400 to-zinc-700 [text-shadow:_0_1px_1px_rgb(0_0_0_/_10%)]">{t("hero.designer")}</h1> -->
      <ShinyText 
        client:load
        text={t("hero.designer")}
        speed={3} 
        className='md:text-6xl text-4xl font-bold leading-tight' 
      />
    </div>
    <div class="md:w-[380px] w-full text-zinc-300/80 py-6 md:py-0">
        <TEnfasis text={t("hero.p")}  />
    </div>
  </div>
</Section>
</div>

