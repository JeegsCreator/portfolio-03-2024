---
import Section from "@layouts/Section.astro"
import { getLangFromUrl, useTranslations } from "@i18n/utils"
import SectionGrid from "@components/SectionGrid.astro"
import CleanYoutube from "@icons/CleanYoutube.astro"
import Shorts from "@icons/Shorts.astro"
import Youtube from "@icons/Youtube.astro"
import SandBox from "@icons/SandBox.astro"
import TimeZipImg from "@lib/images/projects/timezipbg.webp"
import StarsImg from "@lib/images/stars_bg.webp"
import { Image } from "astro:assets"
import ShowcaseImg from "../../public/images/showcase.jpg"
import ov from "@lib/images/openversum-case-study.png"
import { ArrowUpRight } from "lucide-react"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const technologies = [
  "Typescript",
  "React",
  "Astro",
  "Next.js",
  "TailwindCSS",
  "Supabase",
]
---

<Section id="case-study">
  <header class="flex flex-col items-center justify-center mb-8">
    <h2 class="text-5xl text-center font-bold mb-2">
      {t("showcase.title")}
    </h2>
    <span class="text-center font-mono text-muted-foreground"
      >{t("showcase.description")}</span
    >
  </header>
  <main class="flex flex-col md:flex-row items-center justify-center">
    <article class="max-w-xl md:max-h-[320px] flex flex-col">
      <a
        href={`/${lang}/story/openversum`}
        class="relative aspect-7/5 lg:aspect-video max-w-xl w-full rounded-xl overflow-hidden border border-zinc-800"
      >
        <div
          class="absolute z-50 bottom-0 left-0 right-0 bg-gradient-to-t from-black/90 px-4 pb-5 min-h-3/5 flex flex-col justify-end via-80% via-black/80 to-transparent"
        >
          <div>
            <div>
              <!-- tags: Product Development, UI/UX, Design System -->
              <div class="flex gap-2 mb-1">
                {
                  ["Product Development", "UI/UX", "Design System"].map((t) => (
                    <span class="text-nowrap bg-background/70 text-xs text-muted-foreground border border-zinc-800 shadow-md rounded-full py-1 px-2 leading-none font-mono">
                      {t}
                    </span>
                  ))
                }
              </div>
            </div>
            <div class="flex gap-2 items-center pl-1.5">
              <h3 class="font-bold text-lg lg:text-xl">
                {t("openversum.title")}
              </h3>
              <ArrowUpRight size={28} />
            </div>
          </div>
          <p
            class="text-pretty text-card-foreground text-ellipsis line-clamp-2 px-2 leading-tight mt-1 font-mono"
          >
            {t("openversum.description")}
          </p>
        </div>
        <img src={ov.src} alt="" class="-z-10" />
      </a>
    </article>
  </main>
</Section>
