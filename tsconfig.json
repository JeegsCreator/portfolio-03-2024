{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@sections/*": ["./src/sections/*"],
      "@lib/*": ["./src/lib/*"],
      "@icons/*": ["./src/icons/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@data/*": ["./src/data/*"],
      "@images/*": ["./src/data/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
